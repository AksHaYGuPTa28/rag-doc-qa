# --- LLM provider used for answer generation ---
# One of: openai | anthropic | gemini
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
GEMINI_CHAT_MODEL=gemini-flash-latest

# --- Embeddings used for the vector index ---
# One of: openai | local
# "local" uses sentence-transformers (all-MiniLM-L6-v2) and needs no API key,
# so you can index and hybrid-search documents even without an OpenAI key.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4

# --- Storage ---
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
